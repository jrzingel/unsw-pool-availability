# Copy to poolstatus.env and fill in, then: chmod 600 poolstatus.env
# poolstatus.env is gitignored -- keep it that way.

# Mailgun sending domain and its private API key (starts with "key-" on older
# accounts).  Found under Sending > Domains > <your domain> > API keys.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.example.com

# Use https://api.eu.mailgun.net/v3 if the domain is in Mailgun's EU region.
MAILGUN_API_BASE=https://api.mailgun.net/v3

MAIL_FROM="Pool status <pool@mg.example.com>"
MAIL_TO=you@example.com

# Optional.
# MAIL_SUBJECT_PREFIX="UNSW pool lanes"

# When you like to swim -- and which timezone the report is written in -- lives
# in poolstatus/preferences.toml, not here.  This file is only about sending.

# Send only at this local weekday and hour, and exit quietly otherwise.  Set it
# if cron on this box cannot be told a timezone: run the script hourly and let
# it pick its moment -- daylight saving included.
# SEND_AT="Sun 18"

# Extra flags for `poolstatus week`.  Default: --from tomorrow, so a Sunday
# evening email covers Monday to Sunday.  Also useful: --from today,
# --min-lanes 4, --window 6:00-9:00, --days 14
# POOLSTATUS_ARGS="--from tomorrow"
